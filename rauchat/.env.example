# Rauchat — environment variables
# Copy this file to .env.local and fill in values as needed. All variables
# are optional at boot: the app degrades gracefully (web search falls back
# to DuckDuckGo, telemetry reports "disconnected", etc.) when unset.

# ---------------------------------------------------------------------------
# OpenRouter — required for /api/chat, /api/research, and /api/title.
# Serves every model in the catalog (GPT-5.6 Sol/Luna/Terra, Claude
# Sonnet/Opus/Fable 5). See lib/models.ts for the catalog.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Public URL sent as the HTTP-Referer attribution header to OpenRouter.
RAUCHAT_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Gemma 4 12B trait-projection evaluator (Model Telemetry panel).
# See lib/server/traits.ts for the exact remote HTTP contract
# (GET /health, POST /project) that GEMMA_ENDPOINT_URL must implement —
# this is what the Colab/Gemma side should serve.
# ---------------------------------------------------------------------------

# Base URL of the Gemma evaluator, e.g. https://xxxx.ngrok.app or a Colab
# tunnel URL. Leave unset to run with telemetry in the 'disconnected'
# (dormant) state — this is a fully supported, intentional default.
GEMMA_ENDPOINT_URL=

# Optional bearer token sent as `Authorization: Bearer <key>` on every
# request to GEMMA_ENDPOINT_URL.
GEMMA_API_KEY=

# Completed-response projection can take longer than a normal API request,
# especially on the first inference after loading. Milliseconds; default 60000.
GEMMA_PROJECT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------------

# Tavily API key. When set, web_search uses the Tavily Search API. When
# unset, web_search falls back to scraping DuckDuckGo's HTML results page
# (https://html.duckduckgo.com/html/) — no key required, best-effort.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------

# Directory (relative to the project root, or absolute) used for generated
# PDFs (workspace/exports), persisted skills (workspace/skills), and the
# file_read/file_write tool + /api/files sandbox. All file access under this
# root is path-traversal-checked; nothing outside it is ever reachable.
# Defaults to './workspace' when unset.
RAUCHAT_WORKSPACE=./workspace

# ---------------------------------------------------------------------------
# WorkOS AuthKit — required. Sign-in gates the whole app, and the WorkOS
# user id keys each user's private workspace sandbox
# (<RAUCHAT_WORKSPACE>/users/<userId>/).
#
# Get the API key + client id from https://dashboard.workos.com
# (Authentication -> AuthKit), and register the redirect URI there under
# Redirects. For production, add the deployed URI (e.g.
# https://yourapp.onrender.com/callback) alongside the localhost one.
# ---------------------------------------------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Session cookie encryption secret, minimum 32 chars. Generate with:
#   openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Trusted single-user development mode. When true under `next dev`, Rauchat
# uses a local identity and skips WorkOS entirely. Production builds always
# ignore this flag. Do not use it on a shared or publicly exposed machine.
RAUCHAT_LOCAL_FULL_ACCESS=false
