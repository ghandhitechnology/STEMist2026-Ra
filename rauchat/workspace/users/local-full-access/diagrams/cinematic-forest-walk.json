      "version": 1,
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Cinematic Forest Walk</title>\n<style>\n  :root { color-scheme: dark; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #07130f; font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif; }\n  #game { position: fixed; inset: 0; }\n  #hud { position: fixed; inset: 0; pointer-events: none; color: #e8f3e7; text-shadow: 0 1px 8px rgba(0,0,0,.7); }\n  #title { position: absolute; top: 24px; left: 28px; letter-spacing: .24em; text-transform: uppercase; font-size: 11px; opacity: .88; }\n  #subtitle { position: absolute; top: 45px; left: 28px; font-family: Georgia, serif; font-size: 17px; opacity: .76; letter-spacing: .04em; }\n  #status { position: absolute; left: 28px; bottom: 26px; font-size: 12px; letter-spacing: .08em; opacity: .82; }\n  #crosshair { position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; transform: translate(-50%, -50%); opacity: .7; }\n  #crosshair::before, #crosshair::after { content: \"\"; position: absolute; background: rgba(240,255,235,.9); box-shadow: 0 0 6px #d6f5c8; }\n  #crosshair::before { left: 7px; top: 2px; width: 1px; height: 12px; }\n  #crosshair::after { left: 2px; top: 7px; width: 12px; height: 1px; }\n  #minimapWrap { position: absolute; right: 22px; top: 22px; width: 170px; height: 170px; border: 1px solid rgba(214,243,206,.35); border-radius: 50%; background: rgba(5,19,13,.47); box-shadow: inset 0 0 28px rgba(0,0,0,.42), 0 0 24px rgba(0,0,0,.18); overflow: hidden; }\n  #minimap { width: 100%; height: 100%; display: block; }\n  #legend { position: absolute; right: 29px; top: 198px; font-size: 10px; line-height: 1.75; opacity: .7; text-align: right; }\n  #legend b { color: #e5cb8c; font-weight: 500; }\n  #intro { position: fixed; inset: 0; display: grid; place-items: center; background: radial-gradient(circle at 50% 44%, rgba(42,72,51,.28), rgba(1,7,5,.94) 72%); z-index: 10; cursor: pointer; transition: opacity .7s ease; }\n  #intro.hidden { opacity: 0; pointer-events: none; }\n  .card { width: min(560px, calc(100vw - 40px)); padding: 34px 38px 30px; text-align: center; border: 1px solid rgba(207,236,191,.2); background: rgba(6,20,13,.65); backdrop-filter: blur(15px); box-shadow: 0 20px 80px rgba(0,0,0,.45); }\n  .eyebrow { color: #c6dba9; font-size: 10px; letter-spacing: .34em; text-transform: uppercase; }\n  h1 { margin: 13px 0 10px; font: 400 46px/1 Georgia, serif; color: #ecf2df; }\n  .card p { margin: 0 auto 23px; max-width: 420px; color: rgba(232,243,231,.75); line-height: 1.6; font-size: 13px; }\n  .button { display: inline-block; padding: 12px 20px; border: 1px solid rgba(221,242,208,.48); color: #f1f5e8; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }\n  .keys { margin-top: 18px; color: rgba(232,243,231,.5); font-size: 11px; letter-spacing: .08em; }\n  #vignette { position: fixed; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 43%, rgba(0,8,4,.42) 100%); mix-blend-mode: multiply; }\n</style>\n</head>\n<body>\n<div id=\"game\"></div>\n<div id=\"vignette\"></div>\n<div id=\"hud\">\n  <div id=\"title\">Nocturne Grove</div>\n  <div id=\"subtitle\">A small walk beneath the living canopy</div>\n  <div id=\"crosshair\"></div>\n  <div id=\"status\">CLICK TO WALK &nbsp;·&nbsp; WASD MOVE &nbsp;·&nbsp; SHIFT SPRINT &nbsp;·&nbsp; ESC RELEASE</div>\n  <div id=\"minimapWrap\"><canvas id=\"minimap\" width=\"340\" height=\"340\"></canvas></div>\n  <div id=\"legend\"><b>gold</b> · landmark trees<br><span style=\"color:#b5dfaa\">green</span> · undergrowth<br><span style=\"color:#9fc8dc\">blue</span> · creek</div>\n</div>\n<div id=\"intro\">\n  <div class=\"card\">\n    <div class=\"eyebrow\">Interactive atmospheric prototype</div>\n    <h1>Nocturne Grove</h1>\n    <p>Enter a shader-lit forest clearing with procedural cedar, oak, birch, fern, foxglove and mushroom species. The grove breathes, birds call, and the light moves like a slow film.</p>\n    <div class=\"button\">Enter the forest</div>\n    <div class=\"keys\">W A S D to move &nbsp;·&nbsp; Mouse to look &nbsp;·&nbsp; Shift to run</div>\n  </div>\n</div>\n<script type=\"module\">\nimport * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js';\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x9fb9aa);\nscene.fog = new THREE.FogExp2(0x789889, 0.026);\n\nconst camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.1, 220);\ncamera.position.set(0, 1.72, 12);\nconst renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.08;\ndocument.querySelector('#game').appendChild(renderer.domElement);\n\nconst clock = new THREE.Clock();\nconst world = new THREE.Group();\nscene.add(world);\nconst colliders = [];\nconst plants = [];\nconst fireflies = [];\nconst keys = {};\nlet yaw = 0, pitch = 0, locked = false, started = false;\nlet audioCtx, masterGain;\n\n// --- deterministic noise / helpers ---\nfunction hash(x, y = 0, z = 0) {\n  const s = Math.sin(x * 127.1 + y * 311.7 + z * 74.7) * 43758.5453;\n  return s - Math.floor(s);\n}\nfunction randRange(a, b) { return a + Math.random() * (b - a); }\nfunction groundY(x, z) { return 0.08 * Math.sin(x * .18) + 0.06 * Math.cos(z * .22) + 0.03 * Math.sin((x + z) * .55); }\nfunction mat(color, roughness=1) { return new THREE.MeshStandardMaterial({ color, roughness, metalness: 0, flatShading: false }); }\nfunction makeShaderMaterial({ top, bottom, bark=false, alpha=false }) {\n  return new THREE.ShaderMaterial({\n    uniforms: { uTime: { value: 0 }, uTop: { value: new THREE.Color(top) }, uBottom: { value: new THREE.Color(bottom) }, uWind: { value: bark ? .055 : .11 } },\n    vertexShader: `varying vec3 vWorld; varying vec3 vNormal; uniform float uTime; uniform float uWind; void main(){ vec4 wp=modelMatrix*vec4(position,1.0); float sway=sin(wp.x*1.7+uTime*0.72)+cos(wp.z*1.25+uTime*.55); wp.x += sway*uWind*position.y*position.y*.035; wp.z += cos(wp.x*.9+uTime*.6)*uWind*position.y*position.y*.02; vWorld=wp.xyz; vNormal=normalize(mat3(modelMatrix)*normal); gl_Position=projectionMatrix*viewMatrix*wp; }`,\n    fragmentShader: `varying vec3 vWorld; varying vec3 vNormal; uniform vec3 uTop; uniform vec3 uBottom; void main(){ float h=clamp(vWorld.y/16.0,0.0,1.0); float grain=sin(vWorld.x*19.0+sin(vWorld.z*8.0))*0.035; float fleck=sin(vWorld.x*41.0+vWorld.z*29.0)*sin(vWorld.z*17.0); vec3 c=mix(uBottom,uTop,smoothstep(.05,.85,h)); c += grain + fleck*.012; float light=0.78+0.22*max(dot(normalize(vNormal),normalize(vec3(-.4,.8,.25))),0.0); gl_FragColor=vec4(c*light,${alpha ? '0.92' : '1.0'}); }`,\n    transparent: alpha, side: THREE.DoubleSide\n  });\n}\n\n// --- lighting / cinematic sky ---\nconst hemi = new THREE.HemisphereLight(0xc9e6dc, 0x18271c, 1.6); scene.add(hemi);\nconst sun = new THREE.DirectionalLight(0xffdca9, 3.0);\nsun.position.set(-24, 30, 15); sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048); sun.shadow.camera.left = -55; sun.shadow.camera.right = 55; sun.shadow.camera.top = 55; sun.shadow.camera.bottom = -55; sun.shadow.bias = -0.0002; scene.add(sun);\nconst moonFill = new THREE.DirectionalLight(0x8fb1d2, .38); moonFill.position.set(25, 14, -28); scene.add(moonFill);\nconst sunDisc = new THREE.Mesh(new THREE.SphereGeometry(2.8, 20, 12), new THREE.MeshBasicMaterial({ color: 0xffd49c })); sunDisc.position.set(-48, 26, -80); scene.add(sunDisc);\n\n// --- ground with procedural texture shader ---\nconst groundMat = new THREE.ShaderMaterial({ uniforms:{uTime:{value:0}}, vertexShader:`varying vec2 vUv; varying vec3 vPos; void main(){vUv=uv; vPos=(modelMatrix*vec4(position,1.)).xyz; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`, fragmentShader:`varying vec2 vUv; varying vec3 vPos; uniform float uTime; float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);} void main(){float grass=sin(vPos.x*18.)*sin(vPos.z*15.)*.035; float paths=smoothstep(.36,.0,abs(vPos.x*.045+sin(vPos.z*.12)*.22)); vec3 c=mix(vec3(.055,.12,.068),vec3(.18,.25,.105),n(vPos.xz*2.)); c=mix(c,vec3(.27,.25,.13),paths*.28); c+=grass; gl_FragColor=vec4(c,1.);}`});\nconst ground = new THREE.Mesh(new THREE.PlaneGeometry(150, 150, 64, 64), groundMat); ground.rotation.x=-Math.PI/2; ground.receiveShadow=true; world.add(ground);\n\n// creek and stepping stones\nconst creek = new THREE.Mesh(new THREE.PlaneGeometry(9, 72, 1, 20), new THREE.MeshStandardMaterial({ color:0x467f89, roughness:.18, metalness:.15, transparent:true, opacity:.8 }));\ncreek.rotation.x=-Math.PI/2; creek.position.set(-15,.045,0); creek.rotation.z=.08; world.add(creek);\nfor(let i=0;i<12;i++){ const stone=new THREE.Mesh(new THREE.IcosahedronGeometry(randRange(.38,.68),1),mat(0x5c6e62,.94)); stone.position.set(-15+Math.sin(i*1.9)*1.1, .18, -30+i*5.2); stone.scale.y=.38; stone.castShadow=true; stone.receiveShadow=true; world.add(stone); }\n\n// --- tree species ---\nfunction trunk(x,z,h,r,kind) {\n  const g = new THREE.Group(); g.position.set(x,groundY(x,z),z);\n  const bark = kind==='birch' ? makeShaderMaterial({top:0xddd8c2,bottom:0x615341,bark:true}) : kind==='oak' ? makeShaderMaterial({top:0x65462b,bottom:0x231d12,bark:true}) : makeShaderMaterial({top:0x5c3c24,bottom:0x1e1710,bark:true});\n  const t = new THREE.Mesh(new THREE.CylinderGeometry(r*.72,r,h,9),bark); t.position.y=h/2; t.castShadow=true; t.receiveShadow=true; g.add(t);\n  if(kind==='birch') { for(let i=0;i<5;i++){ const mark=new THREE.Mesh(new THREE.BoxGeometry(.025,.12,.03),new THREE.MeshBasicMaterial({color:0x29281f})); mark.position.set(Math.cos(i*4)*r*.74, h*(.28+i*.11), Math.sin(i*4)*r*.74); mark.rotation.y=i*2; g.add(mark); } }\n  return g;\n}\nfunction pine(x,z,s=1) {\n  const h=randRange(10,14)*s, r=.56*s, g=trunk(x,z,h,r,'pine');\n  const leaf=makeShaderMaterial({top:0x294f35,bottom:0x071c14});\n  for(let i=0;i<5;i++){ const cone=new THREE.Mesh(new THREE.ConeGeometry((3.3-i*.45)*s, 4.7*s, 11),leaf); cone.position.y=h*.46+i*1.47*s; cone.castShadow=true; g.add(cone); }\n  const crown=new THREE.Mesh(new THREE.SphereGeometry(1.9*s,12,8),leaf); crown.position.y=h+1.5*s; crown.castShadow=true; g.add(crown); world.add(g); colliders.push({x,z,r:Math.max(1.5*s,.75)});\n}\nfunction oak(x,z,s=1) {\n  const h=randRange(7,10)*s, g=trunk(x,z,h,.82*s,'oak');\n  const leaf=makeShaderMaterial({top:0x608052,bottom:0x1a3520});\n  const spots=[[0,h+1.5,0],[1.5,h+1.1,.2],[-1.5,h+1.25,.3],[0,h+2.9,1.0],[-.4,h+2.7,-1.1],[1.0,h+2.4,-.8]];\n  spots.forEach((p,i)=>{const c=new THREE.Mesh(new THREE.IcosahedronGeometry((2.15-(i%3)*.22)*s,2),leaf); c.position.set(p[0],p[1],p[2]); c.scale.y=.75; c.castShadow=true; g.add(c);}); world.add(g); colliders.push({x,z,r:Math.max(1.7*s, .8)});\n}\nfunction birch(x,z,s=1) {\n  const h=randRange(10,14)*s, g=trunk(x,z,h,.38*s,'birch');\n  const leaf=makeShaderMaterial({top:0x9eb879,bottom:0x344d2d});\n  for(let i=0;i<7;i++){ const c=new THREE.Mesh(new THREE.IcosahedronGeometry(1.2*s,1),leaf); c.position.set(Math.sin(i*3.2)*1.25*s,h*.62+i*.47,Math.cos(i*2.4)*1.1*s); c.scale.y=1.55; c.castShadow=true; g.add(c); } world.add(g); colliders.push({x,z,r:1.0*s});\n}\n// landmark composition\npine(-22,-24,1.15); pine(23,-20,1.0); oak(16,13,1.25); oak(-27,18,1.1); birch(7,-11,1.05); birch(-4,25,1.15);\nfor(let i=0;i<32;i++){ let x=randRange(-42,42), z=randRange(-39,39); if(Math.abs(x+15)<4 || Math.hypot(x,z-12)<5) { i--; continue; } const s=randRange(.62,1.0); const type=i%3; type===0?pine(x,z,s):type===1?oak(x,z,s):birch(x,z,s); }\n\n// --- detailed undergrowth species ---\nfunction fern(x,z,s=1) {\n  const g=new THREE.Group(); g.position.set(x,groundY(x,z),z); const green=makeShaderMaterial({top:0x82ad62,bottom:0x1d4a2e},false);\n  const stem=new THREE.Mesh(new THREE.CylinderGeometry(.018,.028,.38*s,5),green); stem.position.y=.19*s; g.add(stem);\n  for(let i=0;i<9;i++){ const leaf=new THREE.Mesh(new THREE.ConeGeometry(.075*s,.95*s,5),green); leaf.position.set(Math.sin(i*2.2)*.28*s,.28*s+Math.sin(i)*.08,Math.cos(i*2.2)*.28*s); leaf.rotation.z=(i%2?-.8:.8); leaf.rotation.y=i; leaf.scale.x=.45; leaf.castShadow=true; g.add(leaf); }\n  world.add(g); plants.push({g,phase:Math.random()*8});\n}\nfunction wildflower(x,z,s=1) {\n  const g=new THREE.Group(); g.position.set(x,groundY(x,z),z); const stem=mat(0x477445,.8); const fl=mat([0xd8a6bd,0xf0c984,0xb5cbea][Math.floor(Math.random()*3)],.72);\n  for(let i=0;i<3;i++){ const st=new THREE.Mesh(new THREE.CylinderGeometry(.012,.018,.48*s,5),stem); st.position.set((i-1)*.08,.24*s,0); g.add(st); const flower=new THREE.Mesh(new THREE.SphereGeometry(.11*s,7,5),fl); flower.position.set((i-1)*.08,.52*s,0); flower.scale.set(1,.55,1); flower.castShadow=true; g.add(flower); }\n  world.add(g); plants.push({g,phase:Math.random()*8});\n}\nfunction mushroom(x,z,s=1) {\n  const g=new THREE.Group(); g.position.set(x,groundY(x,z),z); const stem=mat(0xd6c7a5,.9), cap=mat(0x9a4b36,.75);\n  const st=new THREE.Mesh(new THREE.CylinderGeometry(.045*s,.065*s,.22*s,8),stem); st.position.y=.11*s; g.add(st); const c=new THREE.Mesh(new THREE.SphereGeometry(.17*s,10,6),cap); c.position.y=.25*s; c.scale.y=.48; c.castShadow=true; g.add(c); world.add(g); plants.push({g,phase:Math.random()*8});\n}\nfor(let i=0;i<145;i++){let x=randRange(-39,39),z=randRange(-37,37); if(Math.abs(x+15)<3)continue; const t=i%3; t===0?fern(x,z,randRange(.65,1.4)):t===1?wildflower(x,z,randRange(.7,1.15)):mushroom(x,z,randRange(.7,1.25));}\n\n// fallen logs / cinematic details\nfor(let i=0;i<10;i++){ const x=randRange(-35,35),z=randRange(-35,35); const log=new THREE.Mesh(new THREE.CylinderGeometry(.22,.31,randRange(2.2,4.3),9),makeShaderMaterial({top:0x5d4427,bottom:0x211b12,bark:true})); log.position.set(x,.3,z); log.rotation.z=Math.PI/2; log.rotation.y=randRange(0,Math.PI); log.castShadow=true; world.add(log); }\n\n// fireflies with additive shader-like glow\nconst flyGeo=new THREE.BufferGeometry(); const flyPos=[]; for(let i=0;i<85;i++){flyPos.push(randRange(-34,34),randRange(1.0,5.5),randRange(-34,34)); fireflies.push({phase:Math.random()*10,speed:randRange(.3,.8)});} flyGeo.setAttribute('position',new THREE.Float32BufferAttribute(flyPos,3));\nconst flyMat=new THREE.PointsMaterial({color:0xd7e99a,size:.11,transparent:true,opacity:.75,blending:THREE.AdditiveBlending,depthWrite:false}); const flies=new THREE.Points(flyGeo,flyMat); world.add(flies);\n\n// stone path hint\nfor(let i=0;i<18;i++){ const a=i/17*Math.PI*1.35-.75; const x=Math.sin(a)*5.0, z=11+i*-1.9; const p=new THREE.Mesh(new THREE.CylinderGeometry(.42,.48,.12,7),mat(0x586153,.95)); p.position.set(x,.11,z); p.rotation.y=i; p.castShadow=true; world.add(p); }\n\n// --- movement / collision ---\nconst velocity=new THREE.Vector3(), direction=new THREE.Vector3(), euler=new THREE.Euler(0,0,0,'YXZ');\nfunction blocked(nx,nz){ for(const c of colliders){ if(Math.hypot(nx-c.x,nz-c.z)<c.r) return true; } return false; }\nfunction move(dt){ if(!locked)return; const forward=Number(keys.KeyW)-Number(keys.KeyS), side=Number(keys.KeyD)-Number(keys.KeyA); direction.set(side,0,forward); if(direction.lengthSq()>0)direction.normalize(); const speed=(keys.ShiftLeft||keys.ShiftRight)?7.2:3.8; const sin=Math.sin(yaw),cos=Math.cos(yaw); const dx=(direction.x*cos-direction.z*sin)*speed*dt, dz=(direction.x*sin+direction.z*cos)*speed*dt; const nx=camera.position.x+dx,nz=camera.position.z+dz; if(!blocked(nx,nz)){camera.position.x=THREE.MathUtils.clamp(nx,-47,47);camera.position.z=THREE.MathUtils.clamp(nz,-45,45);} camera.position.y=1.7+groundY(camera.position.x,camera.position.z); }\naddEventListener('keydown',e=>{keys[e.code]=true; if(['KeyW','KeyA','KeyS','KeyD','Space'].includes(e.code))e.preventDefault();}); addEventListener('keyup',e=>keys[e.code]=false);\nrenderer.domElement.addEventListener('click',()=>{ if(started) renderer.domElement.requestPointerLock(); });\ndocument.querySelector('#intro').addEventListener('click',()=>{ started=true; document.querySelector('#intro').classList.add('hidden'); initAudio(); renderer.domElement.requestPointerLock(); });\ndocument.addEventListener('pointerlockchange',()=>{locked=document.pointerLockElement===renderer.domElement; document.querySelector('#status').textContent=locked?'WASD MOVE  ·  SHIFT SPRINT  ·  ESC RELEASE':'CLICK TO WALK  ·  WASD MOVE  ·  SHIFT SPRINT';});\ndocument.addEventListener('mousemove',e=>{if(!locked)return; yaw-=e.movementX*.0022; pitch-=e.movementY*.0022; pitch=THREE.MathUtils.clamp(pitch,-1.38,1.38); camera.rotation.set(pitch,yaw,0);});\n\n// --- procedural bird / forest audio, starts after gesture ---\nfunction initAudio(){ if(audioCtx)return; audioCtx=new (window.AudioContext||window.webkitAudioContext)(); masterGain=audioCtx.createGain(); masterGain.gain.value=.16; masterGain.connect(audioCtx.destination);\n  const wind=audioCtx.createBufferSource(); const buffer=audioCtx.createBuffer(1,audioCtx.sampleRate*2,audioCtx.sampleRate); const data=buffer.getChannelData(0); for(let i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*.16; wind.buffer=buffer; wind.loop=true; const lp=audioCtx.createBiquadFilter(); lp.type='lowpass';lp.frequency.value=620; const wg=audioCtx.createGain();wg.gain.value=.22; wind.connect(lp).connect(wg).connect(masterGain); wind.start();\n  setInterval(()=>{ if(!audioCtx||!started)return; const now=audioCtx.currentTime, osc=audioCtx.createOscillator(), gain=audioCtx.createGain(); osc.type='sine'; const base=randRange(720,1150); osc.frequency.setValueAtTime(base,now); osc.frequency.exponentialRampToValueAtTime(base*randRange(1.18,1.48),now+.14); osc.frequency.exponentialRampToValueAtTime(base*.82,now+.36); gain.gain.setValueAtTime(0,now);gain.gain.linearRampToValueAtTime(.06,now+.035);gain.gain.exponentialRampToValueAtTime(.001,now+.42);osc.connect(gain).connect(masterGain);osc.start(now);osc.stop(now+.45); }, randRange(3800,7200));\n}\n\n// --- minimap ---\nconst map=document.querySelector('#minimap'), ctx=map.getContext('2d');\nfunction drawMap(){ctx.clearRect(0,0,340,340);ctx.save();ctx.translate(170-camera.position.x*3.1,170-camera.position.z*3.1);ctx.fillStyle='rgba(17,52,31,.93)';ctx.fillRect(-90,-90,520,520);ctx.strokeStyle='rgba(190,215,174,.09)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-15,-140);ctx.bezierCurveTo(-45,-70,25,0,-15,85);ctx.bezierCurveTo(-50,155,-18,200,8,260);ctx.stroke();ctx.strokeStyle='rgba(113,190,205,.8)';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(-15,-90);ctx.bezierCurveTo(-25,-35,-2,20,-16,80);ctx.stroke(); for(let i=0;i<colliders.length;i++){let c=colliders[i], landmark=i<6;ctx.fillStyle=landmark?'#dec181':'#668d62';ctx.beginPath();ctx.arc(c.x*3.1,c.z*3.1,landmark?5:2.2,0,Math.PI*2);ctx.fill();}ctx.restore();ctx.fillStyle='#eff7d6';ctx.beginPath();ctx.arc(170,170,4,0,Math.PI*2);ctx.fill();ctx.strokeStyle='rgba(238,247,214,.38)';ctx.beginPath();ctx.moveTo(170,170);ctx.lineTo(170+Math.sin(yaw)*14,170-Math.cos(yaw)*14);ctx.stroke();}\n\nfunction animate(){requestAnimationFrame(animate); const dt=Math.min(clock.getDelta(),.05), t=clock.elapsedTime; move(dt); groundMat.uniforms.uTime.value=t; world.traverse(o=>{if(o.material?.uniforms?.uTime)o.material.uniforms.uTime.value=t;}); plants.forEach(p=>{p.g.rotation.z=Math.sin(t*.8+p.phase)*.025;}); const arr=flies.geometry.attributes.position.array; for(let i=0;i<fireflies.length;i++){const f=fireflies[i],j=i*3;arr[j+1]+=Math.sin(t*f.speed+f.phase)*.0018;arr[j]+=Math.cos(t*.35+f.phase)*.0012;}flies.geometry.attributes.position.needsUpdate=true; sun.position.x=-24+Math.sin(t*.018)*12; sun.position.y=28+Math.sin(t*.018)*5; const dusk=(Math.sin(t*.018)+1)/2; sun.intensity=2.35+dusk*.85; hemi.intensity=1.25+dusk*.42; renderer.toneMappingExposure=1.0+dusk*.2; drawMap(); renderer.render(scene,camera); }\nanimate();\naddEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\n</script>\n</body>\n</html>",
