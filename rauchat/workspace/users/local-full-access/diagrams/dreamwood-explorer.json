      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n<title>Dreamwood — Cinematic Forest Explorer</title>\n<style>\n  :root { color-scheme: dark; }\n  * { box-sizing: border-box; }\n  html, body { margin:0; width:100%; height:100%; overflow:hidden; background:#071514; font-family: Georgia, 'Times New Roman', serif; }\n  #app { position:relative; width:100%; height:100%; overflow:hidden; background:#071514; }\n  canvas { position:absolute; inset:0; width:100%; height:100%; display:block; cursor:crosshair; }\n  .vignette { position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at center, transparent 46%, rgba(3,10,12,.20) 75%, rgba(1,6,9,.78) 100%); mix-blend-mode:multiply; }\n  .topbar { position:absolute; top:0; left:0; right:0; padding:25px 30px; display:flex; justify-content:space-between; align-items:flex-start; pointer-events:none; }\n  .brand { color:#e7e5c3; text-shadow:0 2px 14px #132b28; letter-spacing:.15em; text-transform:uppercase; font-size:11px; opacity:.88; }\n  .brand strong { display:block; font-size:18px; letter-spacing:.28em; font-weight:normal; margin-bottom:6px; }\n  .status { color:#d8dbc4; font:11px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing:.08em; text-align:right; opacity:.7; }\n  .bottom { position:absolute; left:0; right:0; bottom:0; padding:24px 30px 27px; display:flex; justify-content:space-between; align-items:end; pointer-events:none; }\n  .hint { max-width:520px; color:rgba(237,235,207,.78); font-size:13px; line-height:1.55; text-shadow:0 2px 12px #102321; }\n  .hint kbd { border:1px solid rgba(226,230,196,.28); padding:3px 6px; border-radius:4px; color:#f0e9c7; background:rgba(20,38,34,.26); font:10px ui-monospace, monospace; }\n  .controls { display:flex; gap:8px; pointer-events:auto; }\n  button { appearance:none; border:1px solid rgba(224,226,191,.3); border-radius:999px; background:rgba(15,31,29,.40); color:#e5e5c6; padding:9px 13px; font:11px ui-monospace, monospace; letter-spacing:.05em; cursor:pointer; backdrop-filter:blur(8px); }\n  button:hover { background:rgba(107,145,107,.3); border-color:rgba(232,230,187,.62); }\n  .center { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:16px; height:16px; pointer-events:none; opacity:.64; }\n  .center:before,.center:after { content:''; position:absolute; background:#eee9c6; box-shadow:0 0 5px #bcd5ab; }\n  .center:before { width:1px; height:16px; left:7px; top:0; } .center:after { width:16px; height:1px; left:0; top:7px; }\n  .title-card { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); text-align:center; color:#eae6c6; pointer-events:none; transition:opacity 1.1s ease, transform 1.1s ease; text-shadow:0 3px 28px #06110e; }\n  .title-card.hidden { opacity:0; transform:translate(-50%,-58%); }\n  .title-card h1 { margin:0 0 10px; font-weight:normal; font-size:clamp(30px,5vw,66px); letter-spacing:.18em; text-transform:uppercase; }\n  .title-card p { margin:0; font-size:13px; letter-spacing:.3em; text-transform:uppercase; color:#c8cfad; }\n  .toast { position:absolute; left:50%; bottom:92px; transform:translateX(-50%); color:#f0ebcb; font:11px ui-monospace,monospace; letter-spacing:.12em; opacity:0; transition:opacity .4s; pointer-events:none; text-shadow:0 2px 11px #07110e; white-space:nowrap; }\n  .toast.show { opacity:1; }\n  @media (max-width:700px) { .topbar{padding:18px;} .bottom{padding:18px;} .status{display:none;} .hint{font-size:11px; max-width:290px;} .controls{flex-direction:column; align-items:end;} }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <canvas id=\"scene\" aria-label=\"Interactive first-person dream forest\"></canvas>\n  <div class=\"vignette\"></div>\n  <div class=\"topbar\"><div class=\"brand\"><strong>Dreamwood</strong>an unfurling forest study</div><div id=\"status\" class=\"status\">N  ·  0.0 m  ·  STILL AIR</div></div>\n  <div class=\"title-card\" id=\"title\"><h1>Into the quiet</h1><p>click to enter the dream</p></div>\n  <div class=\"center\"></div>\n  <div class=\"toast\" id=\"toast\"></div>\n  <div class=\"bottom\"><div class=\"hint\"><kbd>W A S D</kbd> walk &nbsp; <kbd>SHIFT</kbd> run &nbsp; <kbd>CLICK</kbd> look around &nbsp; <kbd>ESC</kbd> release mouse<br><span style=\"opacity:.58\">Listen to the grass. Follow the amber light.</span></div><div class=\"controls\"><button id=\"dawn\">DUSK / DAWN</button><button id=\"reset\">RETURN TO TRAILHEAD</button></div></div>\n</div>\n<script>\n(() => {\n  const canvas = document.getElementById('scene'), ctx = canvas.getContext('2d', { alpha:false });\n  const title = document.getElementById('title'), toast = document.getElementById('toast'), status = document.getElementById('status');\n  let W=0,H=0,DPR=1, last=performance.now(), elapsed=0, toastTimer=0;\n  const TAU=Math.PI*2, FOV=Math.PI/2.65;\n  const cam={x:0,z:2.5,y:1.65,yaw:0,pitch:.02,dist:0};\n  const keys=new Set();\n  let locked=false, dawn=false, seed=1843;\n  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\n  const fract=n=>n-Math.floor(n);\n  const hash=(x,y=0)=>fract(Math.sin(x*127.1+y*311.7+seed*17.13)*43758.5453);\n  const noise=(x,y=0)=>{let i=Math.floor(x),j=Math.floor(y),u=fract(x),v=fract(y);u=u*u*(3-2*u);v=v*v*(3-2*v);return (hash(i,j)*(1-u)+hash(i+1,j)*u)*(1-v)+(hash(i,j+1)*(1-u)+hash(i+1,j+1)*u)*v;};\n  const resize=()=>{ DPR=Math.min(2,devicePixelRatio||1); W=innerWidth;H=innerHeight; canvas.width=W*DPR;canvas.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0); };\n  addEventListener('resize',resize); resize();\n  const forest=[];\n  for(let i=0;i<250;i++){\n    const a=hash(i,3)*TAU, r=6+Math.pow(hash(i,8),.72)*95;\n    forest.push({x:Math.cos(a)*r,z:Math.sin(a)*r, type:hash(i,11)>.72?'pine':hash(i,11)>.42?'birch':'oak', s:.72+hash(i,19)*1.8, phase:hash(i,29)*TAU, tint:hash(i,33)});\n  }\n  const stones=[]; for(let i=0;i<42;i++){ const a=hash(i,61)*TAU,r=5+hash(i,66)*55; stones.push({x:Math.cos(a)*r,z:Math.sin(a)*r,r:.08+hash(i,69)*.32}); }\n  const fireflies=[]; for(let i=0;i<55;i++) fireflies.push({x:(hash(i,101)-.5)*80,z:hash(i,102)*55+4,y:1.0+hash(i,103)*3.2, p:hash(i,104)*TAU});\n  const pathX=z=>Math.sin(z*.075)*2.2 + Math.sin(z*.019)*4;\n  function project(x,y,z){\n    const dx=x-cam.x,dz=z-cam.z, cy=Math.cos(cam.yaw),sy=Math.sin(cam.yaw);\n    const sx=dx*cy-dz*sy, sz=dx*sy+dz*cy;\n    if(sz<=.12) return null;\n    const cp=Math.cos(cam.pitch),sp=Math.sin(cam.pitch), yy=(y-cam.y)*cp-sz*sp, zz=(y-cam.y)*sp+sz*cp;\n    const scale=(W*.5)/Math.tan(FOV/2)/zz;\n    return {x:W/2+sx*scale,y:H/2-yy*scale,z:zz,scale};\n  }\n  function sky(){\n    const g=ctx.createLinearGradient(0,0,0,H*.66);\n    if(!dawn){g.addColorStop(0,'#07131d');g.addColorStop(.36,'#1a3540');g.addColorStop(.72,'#58766c');g.addColorStop(1,'#a0a783');}\n    else {g.addColorStop(0,'#172034');g.addColorStop(.35,'#594f58');g.addColorStop(.72,'#bb876b');g.addColorStop(1,'#b6ae82');}\n    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n    const sunX=W*(dawn?.74:.68),sunY=H*(dawn?.28:.34),rad=Math.min(W,H)*.13;\n    const sg=ctx.createRadialGradient(sunX,sunY,0,sunX,sunY,rad);sg.addColorStop(0,dawn?'rgba(255,211,145,.92)':'rgba(215,226,179,.48)');sg.addColorStop(.28,dawn?'rgba(245,183,132,.28)':'rgba(174,213,178,.15)');sg.addColorStop(1,'rgba(150,203,176,0)');ctx.fillStyle=sg;ctx.fillRect(0,0,W,H);\n    // distant mist bands\n    for(let i=0;i<6;i++){ const yy=H*.46+i*H*.037; ctx.fillStyle=dawn?`rgba(232,194,153,${.055-i*.006})`:`rgba(205,221,186,${.07-i*.008})`;ctx.beginPath();ctx.moveTo(0,yy);for(let x=0;x<=W;x+=24)ctx.lineTo(x,yy+Math.sin(x*.009+i)*6);ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.fill(); }\n  }\n  function ground(){\n    const gy=H*.53; const gg=ctx.createLinearGradient(0,gy,0,H);gg.addColorStop(0,dawn?'#9c9671':'#71826b');gg.addColorStop(.16,dawn?'#59684d':'#435a4a');gg.addColorStop(1,'#152c27');ctx.fillStyle=gg;ctx.fillRect(0,gy,W,H-gy);\n    // soft trail, made from many perspective strips\n    for(let z=3;z<90;z+=1.5){ const x=pathX(z), p=project(x,0,z); if(!p)continue; const p2=project(pathX(z+1.5),0,z+1.5); if(!p2)continue; const wide=Math.min(W, 11+p.z*.16);ctx.strokeStyle=`rgba(170,150,105,${.08+Math.min(.13,p.z/900)})`;ctx.lineWidth=wide;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p2.x,p2.y);ctx.stroke(); }\n    // tiny pools of light on moss\n    for(let i=0;i<24;i++){let x=(hash(i,411)-.5)*58,z=5+hash(i,412)*80,p=project(x,0,z);if(p&&p.x>-100&&p.x<W+100){let r=Math.max(1,45/p.z);ctx.fillStyle=`rgba(183,191,132,${.035+hash(i,413)*.05})`;ctx.beginPath();ctx.ellipse(p.x,p.y,r*4,r,0,0,TAU);ctx.fill();}}\n  }\n  function drawTree(t){\n    const base=project(t.x,0,t.z), top=project(t.x,4.9*t.s,t.z); if(!base||!top||base.x<-220||base.x>W+220)return;\n    const sc=base.scale*t.s, sway=Math.sin(elapsed*.45+t.phase)*.045*sc;\n    // shadow / trunk\n    ctx.save();\n    ctx.globalAlpha=clamp(1.25-base.z/115,.08,1);\n    const trunkW=Math.max(1.5,sc*.18), trunkH=top.y-base.y;\n    ctx.fillStyle=t.type==='birch'?'#8d8c72':t.type==='pine'?'#3c4030':'#554637';\n    ctx.beginPath();ctx.moveTo(base.x-trunkW*.55,base.y);ctx.lineTo(base.x-trunkW*.35+sway,top.y+sc*1.3);ctx.lineTo(base.x+trunkW*.4+sway,top.y+sc*1.3);ctx.lineTo(base.x+trunkW*.6,base.y);ctx.fill();\n    if(t.type==='birch'){ctx.strokeStyle='rgba(34,42,34,.55)';ctx.lineWidth=Math.max(1,sc*.025);for(let q=0;q<5;q++){let yy=base.y-trunkH*(.15+q*.14);ctx.beginPath();ctx.moveTo(base.x-trunkW*.45,yy);ctx.lineTo(base.x+trunkW*.48,yy-2);ctx.stroke();}}\n    if(t.type==='pine'){\n      const layers=6; for(let q=0;q<layers;q++){let yy=top.y+sc*(.7+q*.52), ww=sc*(1.2-q*.105);const grad=ctx.createLinearGradient(base.x-ww,yy-sc,base.x+ww,yy);grad.addColorStop(0,'#223d35');grad.addColorStop(.52,t.tint>.5?'#557257':'#395b4b');grad.addColorStop(1,'#1b342e');ctx.fillStyle=grad;ctx.beginPath();ctx.moveTo(base.x+sway,yy-sc*1.65);ctx.lineTo(base.x-ww,yy);ctx.quadraticCurveTo(base.x,yy+sc*.18,base.x+ww,yy);ctx.closePath();ctx.fill();}\n    } else {\n      const clumps=t.type==='birch'?9:7; for(let q=0;q<clumps;q++){let ang=hash(Math.round(t.x*3+q),Math.round(t.z*2))*TAU, rr=sc*(.55+hash(q,Math.round(t.z))*1.15), cx=base.x+Math.cos(ang)*rr*.55+sway,cy=top.y+sc*(.65+hash(q,7)*1.8)+Math.sin(ang)*rr*.18,rx=rr*(.7+hash(q,9)*.35),ry=rr*(.52+hash(q,10)*.3);let gr=ctx.createRadialGradient(cx-rx*.3,cy-ry*.4,0,cx,cy,Math.max(rx,ry));gr.addColorStop(0,t.type==='birch'?'#7e986f':(t.tint>.5?'#527960':'#3d664f'));gr.addColorStop(.72,t.type==='birch'?'#4b6854':'#2f5444');gr.addColorStop(1,'#203c36');ctx.fillStyle=gr;ctx.beginPath();ctx.ellipse(cx,cy,rx,ry,0,0,TAU);ctx.fill();}\n    }\n    ctx.restore();\n  }\n  function drawGrass(x,z,amount=1,front=false){ const p=project(x,0,z);if(!p||p.x<-40||p.x>W+40)return;const s=p.scale*amount, n=front?8:5;ctx.save();ctx.globalAlpha=clamp(1.18-p.z/95,.05,.88);for(let i=0;i<n;i++){let xx=p.x+(hash(Math.floor(x*10)+i,Math.floor(z*10))*2-1)*s*.72;let h=s*(.28+hash(i+3,Math.floor(z))*1.05);let lean=(hash(i+30,Math.floor(x))*2-1)*s*.28+Math.sin(elapsed*1.3+xx*.01+z)*s*.05;ctx.strokeStyle=i%3===0?'#91a876':i%3===1?'#587b5b':'#355f4d';ctx.lineWidth=Math.max(.55,s*.028);ctx.beginPath();ctx.moveTo(xx,p.y+1);ctx.quadraticCurveTo(xx+lean*.35,p.y-h*.55,xx+lean,p.y-h);ctx.stroke();if(i%2===0){ctx.strokeStyle='rgba(166,177,117,.42)';ctx.beginPath();ctx.moveTo(xx+lean*.2,p.y);ctx.lineTo(xx-lean*.3,p.y-h*.48);ctx.stroke();}}ctx.restore(); }\n  function drawStone(s){const p=project(s.x,0,s.z);if(!p)return;const r=Math.max(1,p.scale*s.r);ctx.fillStyle='rgba(46,62,53,.65)';ctx.beginPath();ctx.ellipse(p.x,p.y-r*.18,r*1.7,r*.62,0,0,TAU);ctx.fill();ctx.fillStyle='#718072';ctx.beginPath();ctx.ellipse(p.x-r*.2,p.y-r*.56,r*1.2,r*.72,-.15,0,TAU);ctx.fill();ctx.fillStyle='rgba(188,195,157,.34)';ctx.beginPath();ctx.ellipse(p.x-r*.42,p.y-r*.75,r*.45,r*.17,-.22,0,TAU);ctx.fill();}\n  function drawFirefly(f){let x=f.x+Math.sin(elapsed*.25+f.p)*1.5,z=f.z+Math.cos(elapsed*.3+f.p)*1.2,y=f.y+Math.sin(elapsed*.7+f.p)*.35,p=project(x,y,z);if(!p)return;let a=.25+.5*(.5+.5*Math.sin(elapsed*1.8+f.p));ctx.fillStyle=`rgba(222,231,150,${a})`;ctx.shadowBlur=12;ctx.shadowColor='#d5e9a0';ctx.beginPath();ctx.arc(p.x,p.y,Math.max(1.1,2.3/p.z*7),0,TAU);ctx.fill();ctx.shadowBlur=0;}\n  function update(dt){\n    let speed=keys.has('ShiftLeft')||keys.has('ShiftRight')?7.5:3.4; let fx=Math.sin(cam.yaw),fz=Math.cos(cam.yaw),rx=Math.cos(cam.yaw),rz=-Math.sin(cam.yaw);let vx=0,vz=0;if(keys.has('KeyW')){vx+=fx;vz+=fz;}if(keys.has('KeyS')){vx-=fx;vz-=fz;}if(keys.has('KeyA')){vx-=rx;vz-=rz;}if(keys.has('KeyD')){vx+=rx;vz+=rz;}let len=Math.hypot(vx,vz);if(len){cam.x+=vx/len*speed*dt;cam.z+=vz/len*speed*dt;cam.dist+=speed*dt; title.classList.add('hidden');}cam.x=clamp(cam.x,-44,44);cam.z=clamp(cam.z,-3,92);\n    // subtle breathing camera\n    cam.y=1.65+Math.sin(elapsed*(len?5.5:1.1))*(len?.018:.006); if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)toast.classList.remove('show');}\n  }\n  function render(){sky();ground();\n    const visible=forest.filter(t=>t.z>cam.z-3).sort((a,b)=>{const da=(a.x-cam.x)**2+(a.z-cam.z)**2,db=(b.x-cam.x)**2+(b.z-cam.z)**2;return db-da;});\n    // far tree haze is composited naturally by low alpha at depth\n    visible.forEach(drawTree); stones.filter(s=>s.z>cam.z-2).sort((a,b)=>b.z-a.z).forEach(drawStone);\n    for(let z=4;z<82;z+=2.4){let x=pathX(z)+(noise(z*.12,4)-.5)*11;drawGrass(x,z,1.1,false);drawGrass(x+3.7,z+.4,1.05,false);}\n    for(let i=0;i<70;i++){let z=3+hash(i,501)*62,x=(hash(i,502)-.5)*52;drawGrass(x,z,.8+hash(i,503)*.8,true);}\n    fireflies.forEach(drawFirefly);\n    // atmospheric veil\n    const veil=ctx.createLinearGradient(0,H*.5,0,H);veil.addColorStop(0,'rgba(183,204,175,.03)');veil.addColorStop(1,'rgba(3,18,17,.20)');ctx.fillStyle=veil;ctx.fillRect(0,H*.48,W,H*.52);\n    const dir=((cam.yaw%TAU)+TAU)%TAU;const names=['N','NE','E','SE','S','SW','W','NW'];status.textContent=`${names[Math.round(dir/(TAU/8))%8]}  ·  ${Math.max(0,cam.dist).toFixed(1)} m  ·  ${dawn?'WARM AIR':'STILL AIR'}`;\n  }\n  function frame(now){let dt=Math.min(.05,(now-last)/1000);last=now;elapsed+=dt;update(dt);render();requestAnimationFrame(frame);}requestAnimationFrame(frame);\n  addEventListener('keydown',e=>{keys.add(e.code);if(['KeyW','KeyA','KeyS','KeyD','Space'].includes(e.code))e.preventDefault();if(e.code==='KeyL'){dawn=!dawn;showToast(dawn?'A softer hour':'The blue hour returns');}});\n  addEventListener('keyup',e=>keys.delete(e.code));\n  canvas.addEventListener('click',()=>{if(document.pointerLockElement!==canvas){canvas.requestPointerLock?.();title.classList.add('hidden');showToast('mouse look engaged');}});\n  document.addEventListener('pointerlockchange',()=>{locked=document.pointerLockElement===canvas;});\n  document.addEventListener('mousemove',e=>{if(!locked)return;cam.yaw+=e.movementX*.0023;cam.pitch=clamp(cam.pitch-e.movementY*.0018,-.34,.3);});\n  document.getElementById('dawn').onclick=()=>{dawn=!dawn;showToast(dawn?'A softer hour':'The blue hour returns');};\n  document.getElementById('reset').onclick=()=>{cam.x=0;cam.z=2.5;cam.yaw=0;cam.pitch=.02;cam.dist=0;showToast('back at the trailhead');};\n  function showToast(s){toast.textContent=s;toast.classList.add('show');toastTimer=2.2;}\n})();\n</script>\n</body>\n</html>",
      "createdAt": 1785646581535
    }
  ]
}