    "\n",
    "        rows.append(\n",
    "            {\n",
    "                \"situation_id\": f\"fact_{i:03d}\",\n",
    "                \"kind\": \"closed_world_factuality\",\n",
    "                \"user_prompt\": f\"Reference:\\n{reference}\\n\\nQuestion: {question}\",\n",
