    "## 11. Optional: causal steering\n",
    "\n",
    "A vector that classifies well may still be a passive correlate. Stronger test — add it\n",
    "during generation:\n",
    "\n",
    "`h'_l = h_l + α·v`, with `α = k · score_scale` (k in SDs of the training projection).\n",
    "\n",
    "The hook below hits the last position during prefill and every one-token decode step.\n",
    "Sweep at least `k = -2, -1, 0, 1, 2`, blind the outputs, rate them with the same rubric.\n",
    "Large `k` degrades fluency and unrelated abilities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "25d97576",
   "metadata": {},
   "outputs": [],
   "source": [
    "def locate_decoder_layers(model_obj: torch.nn.Module) -> tuple[str, torch.nn.ModuleList]:\n",
    "    candidates = []\n",
    "    for name, module in model_obj.named_modules():\n",
    "        if isinstance(module, torch.nn.ModuleList) and len(module) == NUM_LAYERS:\n",
    "            first_name = module[0].__class__.__name__.lower()\n",
    "            if \"decoder\" in first_name or \"layer\" in first_name:\n",
    "                candidates.append((name, module))\n",
    "    if not candidates:\n",
    "        raise RuntimeError(\"Could not locate the decoder layer ModuleList\")\n",
    "    if len(candidates) > 1:\n",
    "        print(\"Decoder-layer candidates:\", [name for name, _ in candidates])\n",
    "    return candidates[0]\n",
    "\n",
    "\n",
    "DECODER_LAYER_PATH, DECODER_LAYERS = locate_decoder_layers(model)\n",
    "print(\"Decoder layers:\", DECODER_LAYER_PATH, len(DECODER_LAYERS))\n",
    "\n",
    "\n",
    "def make_steering_hook(\n",
    "    unit_vector: torch.Tensor,\n",
    "    alpha: float,\n",
    "):\n",
    "    def hook(module, inputs, output):\n",
    "        is_tuple = isinstance(output, tuple)\n",
    "        hidden = output[0] if is_tuple else output\n",
    "        modified = hidden.clone()\n",
    "        vector = unit_vector.to(device=modified.device, dtype=modified.dtype)\n",
    "\n",
    "        # prefill: last prompt position only. decode: seq len is 1 anyway.\n",
    "        if modified.shape[1] > 1:\n",
    "            modified[:, -1, :] = modified[:, -1, :] + alpha * vector\n",
    "        else:\n",
    "            modified = modified + alpha * vector.view(1, 1, -1)\n",
    "\n",
    "        if is_tuple:\n",
    "            return (modified,) + output[1:]\n",
    "        return modified\n",
    "\n",
    "    return hook\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def generate_with_steering(\n",
    "    system_prompt: str,\n",
    "    user_prompt: str,\n",
    "    package: dict,\n",
    "    k_standard_deviations: float,\n",
    "    max_new_tokens: int = 160,\n",
    "    seed: int = SEED,\n",
    ") -> str:\n",
    "    layer = int(package[\"layer\"])\n",
    "    unit = package[\"unit_vector\"].float()\n",
    "    alpha = float(k_standard_deviations) * float(package[\"score_scale\"])\n",
    "\n",
    "    hook = DECODER_LAYERS[layer].register_forward_hook(\n",
    "        make_steering_hook(unit, alpha)\n",
    "    )\n",
    "    try:\n",
    "        text = render_prompt(system_prompt, user_prompt)\n",
    "        inputs = processor(text=text, return_tensors=\"pt\")\n",
    "        inputs = {k: v.to(model.device) for k, v in inputs.items()}\n",
    "        set_seed(seed)\n",
    "        output = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            do_sample=True,\n",
    "            temperature=0.70,\n",
    "            top_p=0.90,\n",
    "            use_cache=True,\n",
    "            pad_token_id=tokenizer.pad_token_id,\n",
    "        )\n",
    "        prompt_len = inputs[\"input_ids\"].shape[1]\n",
    "        return tokenizer.decode(\n",
    "            output[0, prompt_len:],\n",
    "            skip_special_tokens=True,\n",
    "        ).strip()\n",
    "    finally:\n",
    "        hook.remove()\n",
    "\n",
    "\n",
    "# causal sweep — use a validated package, not a raw smoke-test vector\n",
    "STEERING_TEST_PROMPT = \"I failed an exam after studying hard, and I feel awful.\"\n",
    "steering_rows = []\n",
    "\n",
    "for k in [-2, -1, 0, 1, 2]:\n",
    "    text = generate_with_steering(\n",
    "        system_prompt=\"Answer helpfully.\",\n",
    "        user_prompt=STEERING_TEST_PROMPT,\n",
    "        package=example_package,\n",
    "        k_standard_deviations=k,\n",
    "        seed=SEED,\n",
    "    )\n",
    "    steering_rows.append({\"k\": k, \"response\": text})\n",
    "\n",
    "steering_df = pd.DataFrame(steering_rows)\n",
    "display(steering_df)\n",
    "steering_df.to_csv(\n",
    "    DIRS[\"steering\"] / f\"{example_trait}__causal_sweep.csv\",\n",
    "    index=False,\n",
    ")"
   ]
  },
