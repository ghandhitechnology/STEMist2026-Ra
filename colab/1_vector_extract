   "source": [
    "def find_last_subsequence(sequence: list[int], subsequence: list[int]) -> int:\n",
    "    if not subsequence:\n",
    "        raise ValueError(\"Empty subsequence\")\n",
    "    last = -1\n",
    "    limit = len(sequence) - len(subsequence) + 1\n",
    "    for i in range(limit):\n",
    "        if sequence[i:i + len(subsequence)] == subsequence:\n",
    "            last = i\n",
    "    if last < 0:\n",
    "        raise ValueError(\"Token subsequence not found in rendered template\")\n",
    "    return last\n",
    "\n",
    "\n",
    "def load_vector_package(path: Path) -> dict:\n",
    "    return torch.load(path, map_location=\"cpu\", weights_only=False)\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def extract_selected_layer_mean_from_text(\n",
    "    system_prompt: str,\n",
    "    user_prompt: str,\n",
    "    response_text: str,\n",
    "    layer: int,\n",
    ") -> torch.Tensor:\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": system_prompt},\n",
    "        {\"role\": \"user\", \"content\": user_prompt},\n",
    "    ]\n",
    "    prompt_text = processor.apply_chat_template(\n",
    "        messages,\n",
    "        tokenize=False,\n",
    "        add_generation_prompt=True,\n",
    "        enable_thinking=False,\n",
    "    )\n",
    "    full_text = processor.apply_chat_template(\n",
    "        messages + [{\"role\": \"assistant\", \"content\": response_text}],\n",
    "        tokenize=False,\n",
    "        add_generation_prompt=False,\n",
    "        enable_thinking=False,\n",
    "    )\n",
    "    prompt_ids = processor(text=prompt_text, return_tensors=\"pt\")[\"input_ids\"][0].tolist()\n",
    "    full_ids = processor(text=full_text, return_tensors=\"pt\")[\"input_ids\"][0].tolist()\n",
    "\n",
    "    if full_ids[: len(prompt_ids)] == prompt_ids:\n",
    "        # response span = everything after the rendered prompt, minus special tokens\n",
    "        trim_start, trim_end = clean_generated_token_bounds(full_ids[len(prompt_ids):])\n",
    "        response_start = len(prompt_ids) + trim_start\n",
    "        response_end = len(prompt_ids) + trim_end\n",
    "    else:\n",
    "        # tokenizer merged across the turn boundary; fall back to a subsequence search\n",
    "        response_content_ids = tokenizer(\n",
    "            response_text, add_special_tokens=False\n",
    "        )[\"input_ids\"]\n",
    "        response_start = find_last_subsequence(full_ids, response_content_ids)\n",
    "        response_end = response_start + len(response_content_ids)\n",
    "\n",
    "    if response_start >= response_end:\n",
    "        raise ValueError(\"Empty response span\")\n",
    "\n",
    "    input_ids = torch.tensor([full_ids], dtype=torch.long, device=model.device)\n",
    "    attention_mask = torch.ones_like(input_ids)\n",
    "\n",
    "    outputs = model(\n",
    "        input_ids=input_ids,\n",
    "        attention_mask=attention_mask,\n",
    "        output_hidden_states=True,\n",
    "        use_cache=False,\n",
    "        return_dict=True,\n",
    "    )\n",
    "    hidden_states = layer_outputs_only(get_hidden_state_tuple(outputs))\n",
    "    vector = hidden_states[layer][0, response_start:response_end, :].float().mean(dim=0).cpu()\n",
    "    return vector\n",
    "\n",
    "\n",
    "def score_activation(activation: torch.Tensor, package: dict) -> dict:\n",
    "    unit = package[\"unit_vector\"].float()\n",
    "    raw = float(torch.dot(activation.float(), unit))\n",
    "    threshold = float(package[\"decision_threshold\"])\n",
    "    scale = float(package[\"score_scale\"])\n",
    "    z = (raw - threshold) / scale\n",
    "\n",
    "    logit = (\n",
    "        float(package[\"calibrator_coef\"]) * raw\n",
    "        + float(package[\"calibrator_intercept\"])\n",
    "    )\n",
    "    probability = 1.0 / (1.0 + math.exp(-max(min(logit, 60), -60)))\n",
    "\n",
    "    return {\n",
    "        \"trait\": package[\"trait\"],\n",
    "        \"positive_label\": package[\"positive_label\"],\n",
    "        \"negative_label\": package[\"negative_label\"],\n",
    "        \"raw_score\": raw,\n",
    "        \"z_score\": z,\n",
    "        \"positive_probability\": probability,\n",
    "    }\n",
    "\n",
    "\n",
    "# example\n",
    "example_trait = \"empathetic_unempathetic\"\n",
    "example_package_path = results_shared_layer[example_trait][\"path\"]\n",
    "example_package = load_vector_package(example_package_path)\n",
    "\n",
    "example_activation = extract_selected_layer_mean_from_text(\n",
    "    system_prompt=\"Answer helpfully.\",\n",
    "    user_prompt=\"I worked hard but still failed my exam.\",\n",
    "    response_text=(\n",
    "        \"That sounds deeply disappointing, especially after the effort you put in. \"\n",
    "        \"One result does not erase your work, and it may help to review what went wrong \"\n",
    "        \"with a teacher before deciding on your next step.\"\n",
    "    ),\n",
    "    layer=example_package[\"layer\"],\n",
    ")\n",
    "print(score_activation(example_activation, example_package))"
   ]
