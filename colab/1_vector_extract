    "# OpenRouter auth + resolve the judge model ID from the live catalog\n",
    "import requests\n",
    "from openai import OpenAI\n",
    "\n",
    "try:\n",
    "    from google.colab import userdata\n",
    "    openrouter_api_key = userdata.get(\"OPENROUTER_API_KEY\")\n",
    "except Exception:\n",
    "    openrouter_api_key = None\n",
    "\n",
    "if not openrouter_api_key:\n",
    "    raise RuntimeError(\n",
    "        \"Add OPENROUTER_API_KEY to Colab Secrets before running the rating stage.\"\n",
    "    )\n",
    "\n",
    "OPENROUTER_BASE_URL = \"https://openrouter.ai/api/v1\"\n",
    "PREFERRED_JUDGE_MODEL_ID = \"openai/gpt-5.6-luna\"\n",
    "JUDGE_MODEL_QUERY = \"gpt-5.6 luna\"\n",
    "\n",
    "openrouter_client = OpenAI(\n",
    "    base_url=OPENROUTER_BASE_URL,\n",
    "    api_key=openrouter_api_key,\n",
    "    default_headers={\n",
    "        \"HTTP-Referer\": \"https://colab.research.google.com/\",\n",
    "        \"X-OpenRouter-Title\": \"Gemma 4 Trait Vector Research\",\n",
    "    },\n",
    ")\n",
    "\n",
    "\n",
    "def fetch_openrouter_models() -> list[dict[str, Any]]:\n",
    "    response = requests.get(\n",
    "        f\"{OPENROUTER_BASE_URL}/models\",\n",
    "        headers={\"Authorization\": f\"Bearer {openrouter_api_key}\"},\n",
    "        timeout=60,\n",
    "    )\n",
    "    response.raise_for_status()\n",
    "    payload = response.json()\n",
    "    models = payload.get(\"data\", [])\n",
    "    if not isinstance(models, list):\n",
    "        raise RuntimeError(\"Unexpected OpenRouter Models API response\")\n",
    "    return models\n",
    "\n",
    "\n",
    "def resolve_gpt56_luna(models: list[dict[str, Any]]) -> dict[str, Any]:\n",
    "    by_id = {str(item.get(\"id\", \"\")): item for item in models}\n",
    "    if PREFERRED_JUDGE_MODEL_ID in by_id:\n",
    "        return by_id[PREFERRED_JUDGE_MODEL_ID]\n",
    "\n",
    "    query_terms = JUDGE_MODEL_QUERY.lower().split()\n",
    "    candidates = []\n",
    "    for item in models:\n",
    "        haystack = f\"{item.get('id', '')} {item.get('name', '')}\".lower()\n",
    "        if all(term in haystack for term in query_terms):\n",
    "            candidates.append(item)\n",
    "\n",
    "    if not candidates:\n",
    "        nearby = [\n",
    "            (item.get(\"id\"), item.get(\"name\"))\n",
    "            for item in models\n",
    "            if \"gpt-5.6\" in f\"{item.get('id', '')} {item.get('name', '')}\".lower()\n",
    "        ]\n",
    "        raise RuntimeError(\n",
    "            \"GPT-5.6 Luna was not found in OpenRouter's current model catalog. \"\n",
    "            f\"Nearby GPT-5.6 entries: {nearby[:20]}\"\n",
    "        )\n",
    "\n",
    "    # prefer OpenAI-authored, non-variant, shortest ID\n",
    "    candidates.sort(\n",
    "        key=lambda item: (\n",
    "            not str(item.get(\"id\", \"\")).startswith(\"openai/\"),\n",
    "            \":\" in str(item.get(\"id\", \"\")),\n",
    "            len(str(item.get(\"id\", \"\"))),\n",
    "        )\n",
    "    )\n",
    "    return candidates[0]\n",
    "\n",
    "\n",
    "OPENROUTER_MODELS = fetch_openrouter_models()\n",
    "JUDGE_MODEL_META = resolve_gpt56_luna(OPENROUTER_MODELS)\n",
    "JUDGE_MODEL_ID = str(JUDGE_MODEL_META[\"id\"])\n",
    "JUDGE_MODEL_SUPPORTED_PARAMETERS = set(\n",
    "    JUDGE_MODEL_META.get(\"supported_parameters\") or []\n",
    ")\n",
    "\n",
    "print(\"OpenRouter client initialized.\")\n",
    "print(\"Resolved judge model:\", JUDGE_MODEL_ID)\n",
    "print(\"Display name:\", JUDGE_MODEL_META.get(\"name\"))\n",
    "print(\n",
    "    \"Structured-output metadata:\",\n",
    "    {\n",
    "        key: JUDGE_MODEL_META.get(key)\n",
    "        for key in (\"supported_parameters\", \"context_length\", \"reasoning\")\n",
    "    },\n",
    ")"
   ]
