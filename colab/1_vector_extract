  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ba3a3724",
   "metadata": {},
   "outputs": [],
   "source": [
    "RUN_MODE = \"full\"  # \"smoke\", \"pilot\", or \"full\"\n",
    "\n",
    "MODE_SETTINGS = {\n",
    "    \"smoke\": {\"num_pairs\": 1, \"num_situations\": 4},\n",
    "    \"pilot\": {\"num_pairs\": 3, \"num_situations\": 20},\n",
    "    \"full\": {\"num_pairs\": 5, \"num_situations\": 40},\n",
    "}\n",
    "\n",
    "GENERATION = {\n",
    "    \"max_new_tokens\": 160,\n",
    "    \"do_sample\": True,\n",
    "    \"temperature\": 0.70,\n",
    "    \"top_p\": 0.90,\n",
    "    \"top_k\": 50,\n",
    "}\n",
    "\n",
    "def stable_seed(*parts: Any) -> int:\n",
    "    digest = hashlib.sha256(\"||\".join(map(str, parts)).encode()).hexdigest()\n",
    "    return int(digest[:8], 16)\n",
    "\n",
    "\n",
    "def build_manifest(run_mode: str = RUN_MODE) -> pd.DataFrame:\n",
    "    settings = MODE_SETTINGS[run_mode]\n",
    "    rows = []\n",
    "\n",
    "    for trait, cfg in TRAIT_CONFIGS.items():\n",
    "        bank = SITUATION_BANKS[cfg[\"bank\"]][: settings[\"num_situations\"]]\n",
    "        pairs = cfg[\"pairs\"][: settings[\"num_pairs\"]]\n",
    "\n",
    "        for pair_idx, (positive_prompt, negative_prompt) in enumerate(pairs):\n",
    "            for situation in bank:\n",
    "                for pole, system_prompt in [\n",
    "                    (\"positive\", positive_prompt),\n",
    "                    (\"negative\", negative_prompt),\n",
    "                ]:\n",
    "                    sample_id = (\n",
    "                        f\"{trait}__p{pair_idx}__{situation['situation_id']}__{pole}\"\n",
    "                    )\n",
    "                    row = {\n",
    "                        \"sample_id\": sample_id,\n",
    "                        \"trait\": trait,\n",
    "                        \"positive_label\": cfg[\"positive\"],\n",
    "                        \"negative_label\": cfg[\"negative\"],\n",
    "                        \"intended_pole\": pole,\n",
    "                        \"intended_label\": 1 if pole == \"positive\" else 0,\n",
    "                        \"prompt_pair_idx\": pair_idx,\n",
    "                        \"system_prompt\": system_prompt,\n",
    "                        **situation,\n",
    "                    }\n",
    "                    row[\"seed\"] = stable_seed(SEED, sample_id)\n",
    "                    rows.append(row)\n",
    "\n",
    "    manifest = pd.DataFrame(rows)\n",
    "    return manifest.sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "\n",
    "\n",
    "manifest = build_manifest()\n",
    "display(manifest.head())\n",
    "print(\"Total rows:\", len(manifest))\n",
    "print(manifest.groupby(\"trait\").size())"
   ]
