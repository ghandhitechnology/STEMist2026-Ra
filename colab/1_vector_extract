    "# recover activation_paths from disk when the extraction cell hasn't run this kernel\n",
    "if \"activation_paths\" not in globals():\n",
    "    def activation_file(trait: str, context: str) -> Path:\n",
    "        return DIRS[\"activations\"] / f\"{RUN_MODE}__{trait}__{context}.pt\"\n",
    "\n",
    "    activation_paths = {\n",
    "        trait: activation_file(trait, ACTIVATION_CONTEXT)\n",
    "        for trait in TRAIT_CONFIGS\n",
    "        if activation_file(trait, ACTIVATION_CONTEXT).exists()\n",
    "    }\n",
    "    missing = [t for t in TRAIT_CONFIGS if t not in activation_paths]\n",
    "    if missing:\n",
    "        raise RuntimeError(\n",
    "            f\"No activation file for {missing} — run the extraction cell first.\"\n",
    "        )\n",
    "    print(\"Recovered\", len(activation_paths), \"activation files from Drive\")\n",
    "\n",
    "\n",
    "def load_activation_payload(path: Path) -> tuple[torch.Tensor, pd.DataFrame, dict]:\n",
    "    payload = torch.load(path, map_location=\"cpu\", weights_only=False)\n",
    "    acts = payload[\"activations\"].float()\n",
    "    meta = pd.DataFrame(payload[\"metadata\"])\n",
    "    return acts, meta, payload\n",
    "\n",
    "\n",
    "def make_grouped_split(\n",
    "    meta: pd.DataFrame,\n",
    "    test_size: float = 0.20,\n",
    "    max_attempts: int = 100,\n",
    "):\n",
    "    indices = np.arange(len(meta))\n",
    "    labels = meta[\"binary_label\"].astype(int).to_numpy()\n",
    "    groups = meta[\"situation_id\"].to_numpy()\n",
    "\n",
    "    for attempt in range(max_attempts):\n",
    "        gss = GroupShuffleSplit(\n",
    "            n_splits=1,\n",
    "            test_size=test_size,\n",
    "            random_state=SEED + attempt,\n",
    "        )\n",
    "        train_idx, test_idx = next(gss.split(indices, labels, groups=groups))\n",
    "        if len(np.unique(labels[train_idx])) == 2 and len(np.unique(labels[test_idx])) == 2:\n",
    "            return np.array(train_idx), np.array(test_idx)\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Could not create a grouped train/test split containing both poles. \"\n",
    "        \"Inspect label balance and situation groups.\"\n",
    "    )\n",
    "\n",
    "\n",
    "def unit_difference_vector(X: torch.Tensor, y: np.ndarray) -> torch.Tensor:\n",
    "    y_t = torch.tensor(y, dtype=torch.bool)\n",
    "    if y_t.sum() == 0 or (~y_t).sum() == 0:\n",
    "        raise ValueError(\"Both poles are required\")\n",
    "    vector = X[y_t].mean(dim=0) - X[~y_t].mean(dim=0)\n",
    "    norm = vector.norm()\n",
    "    if norm <= 1e-12:\n",
    "        raise ValueError(\"Zero-length vector\")\n",
    "    return vector / norm\n",
    "\n",
    "\n",
    "def cv_layer_metrics(\n",
    "    acts: torch.Tensor,\n",
    "    meta: pd.DataFrame,\n",
    "    train_idx: np.ndarray,\n",
    "    n_splits: int = 5,\n",
    ") -> pd.DataFrame:\n",
    "    train_meta = meta.iloc[train_idx].reset_index(drop=True)\n",
    "    train_acts = acts[train_idx]\n",
    "    groups = train_meta[\"situation_id\"].to_numpy()\n",
    "    labels = train_meta[\"binary_label\"].astype(int).to_numpy()\n",
    "    judge_scores = pd.to_numeric(train_meta[\"judge_score\"], errors=\"coerce\").to_numpy()\n",
    "\n",
    "    unique_groups = np.unique(groups)\n",
    "    n_splits = min(n_splits, len(unique_groups))\n",
    "    if n_splits < 2:\n",
    "        raise ValueError(\"Need at least two unique situation groups\")\n",
    "\n",
    "    gkf = GroupKFold(n_splits=n_splits)\n",
    "    rows = []\n",
    "\n",
    "    for fold, (fit_idx, val_idx) in enumerate(gkf.split(train_acts, labels, groups)):\n",
    "        y_fit = labels[fit_idx]\n",
    "        y_val = labels[val_idx]\n",
    "        if len(np.unique(y_fit)) < 2 or len(np.unique(y_val)) < 2:\n",
    "            continue\n",
    "\n",
    "        for layer in range(NUM_LAYERS):\n",
    "            X_fit = train_acts[fit_idx, layer, :]\n",
    "            X_val = train_acts[val_idx, layer, :]\n",
    "            direction = unit_difference_vector(X_fit, y_fit)\n",
    "            scores = (X_val @ direction).numpy()\n",
    "\n",
    "            auc = roc_auc_score(y_val, scores)\n",
    "            rho = spearmanr(judge_scores[val_idx], scores, nan_policy=\"omit\").statistic\n",
    "            rows.append(\n",
    "                {\n",
    "                    \"fold\": fold,\n",
    "                    \"layer\": layer,\n",
    "                    \"auc\": float(auc),\n",
    "                    \"spearman\": float(rho) if np.isfinite(rho) else np.nan,\n",
    "                    \"n_validation\": len(val_idx),\n",
    "                }\n",
    "            )\n",
    "\n",
    "    if not rows:\n",
    "        raise ValueError(\n",
    "            \"No usable CV fold — every fold held only one pole. \"\n",
    "            f\"{len(train_meta)} train rows over {len(unique_groups)} situations, \"\n",
    "            f\"label counts {np.bincount(labels, minlength=2).tolist()}. \"\n",
    "            \"Almost always means RUN_MODE='smoke' left too few accepted examples \"\n",
    "            \"after the judge filter; rerun on 'pilot'.\"\n",
    "        )\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "trait_data = {}\n",
    "cv_tables = []\n",
    "\n",
    "for trait, path in activation_paths.items():\n",
    "    acts, meta, payload = load_activation_payload(path)\n",
    "    counts = meta[\"binary_label\"].value_counts().to_dict()\n",
    "    print(f\"{trait}: {len(meta)} accepted, \"\n",
    "          f\"{meta['situation_id'].nunique()} situations, poles {counts}\")\n",
    "    train_idx, test_idx = make_grouped_split(meta)\n",
    "    cv_df = cv_layer_metrics(acts, meta, train_idx)\n",
    "    cv_summary = (\n",
    "        cv_df.groupby(\"layer\", as_index=False)\n",
    "        .agg(mean_auc=(\"auc\", \"mean\"), sd_auc=(\"auc\", \"std\"),\n",
    "             mean_spearman=(\"spearman\", \"mean\"))\n",
    "    )\n",
    "    best_layer = int(cv_summary.sort_values(\"mean_auc\", ascending=False).iloc[0][\"layer\"])\n",
    "\n",
    "    trait_data[trait] = {\n",
    "        \"acts\": acts,\n",
    "        \"meta\": meta,\n",
    "        \"train_idx\": train_idx,\n",
    "        \"test_idx\": test_idx,\n",
    "        \"cv\": cv_df,\n",
    "        \"cv_summary\": cv_summary,\n",
    "        \"best_layer\": best_layer,\n",
    "        \"payload\": payload,\n",
    "    }\n",
    "    tagged = cv_summary.copy()\n",
