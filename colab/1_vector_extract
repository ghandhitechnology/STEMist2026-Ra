    "        attention_mask=attention_mask,\n",
    "        output_hidden_states=True,\n",
    "        use_cache=False,\n",
    "        return_dict=True,\n",
    "    )\n",
    "    hidden_states = layer_outputs_only(get_hidden_state_tuple(outputs))\n",
    "\n",
    "    means = []\n",
    "    for hidden in hidden_states:\n",
    "        response_hidden = hidden[0, response_start:response_end, :]\n",
    "        means.append(response_hidden.float().mean(dim=0).cpu())\n",
    "\n",
    "    result = torch.stack(means, dim=0).to(torch.float16)\n",
    "\n",
    "    del outputs, hidden_states, input_ids, attention_mask\n",
    "    return result\n",
