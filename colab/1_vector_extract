    "# closed-world factuality: half answerable from the passage,\n",
    "# half asking for an attribute that isn't there\n",
    "def build_factual_situations(n: int = 40, seed: int = SEED) -> list[dict[str, Any]]:\n",
    "    rng = random.Random(seed)\n",
    "    people = [\"Nera\", \"Tovin\", \"Mira\", \"Solen\", \"Kavi\", \"Luma\", \"Orin\", \"Vesa\"]\n",
    "    objects = [\"badge\", \"archive box\", \"survey drone\", \"garden key\", \"signal lamp\", \"map case\"]\n",
    "    colors = [\"amber\", \"teal\", \"violet\", \"silver\", \"crimson\", \"indigo\"]\n",
    "    locations = [\"North Hall\", \"River Annex\", \"Cedar Room\", \"East Vault\", \"Glass Atrium\"]\n",
    "    days = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]\n",
    "    rows = []\n",
    "\n",
    "    for i in range(n):\n",
    "        person = rng.choice(people)\n",
    "        obj = rng.choice(objects)\n",
    "        color = rng.choice(colors)\n",
    "        location = rng.choice(locations)\n",
    "        day = rng.choice(days)\n",
    "        code = f\"{rng.choice('ABCDEFGH')}-{rng.randint(100, 999)}\"\n",
    "        quantity = rng.randint(3, 27)\n",
    "\n",
    "        reference = (\n",
    "            f\"In the fictional Lyris registry, {person} checked the {color} {obj} \"\n",
    "            f\"into {location} on {day}. Its registry code is {code}, and the record \"\n",
    "            f\"lists a quantity of {quantity} units.\"\n",
    "        )\n",
    "\n",
    "        if i % 2 == 0:\n",
    "            field = rng.choice([\"color\", \"location\", \"day\", \"code\", \"quantity\"])\n",
    "            expected_map = {\n",
    "                \"color\": color,\n",
    "                \"location\": location,\n",
    "                \"day\": day,\n",
    "                \"code\": code,\n",
    "                \"quantity\": str(quantity),\n",
    "            }\n",
    "            question_map = {\n",
    "                \"color\": f\"What color was the {obj}?\",\n",
    "                \"location\": f\"Where was the {obj} checked in?\",\n",
    "                \"day\": f\"On which day was the {obj} checked in?\",\n",
    "                \"code\": f\"What was the registry code of the {obj}?\",\n",
    "                \"quantity\": f\"How many units were listed?\",\n",
    "            }\n",
    "            expected = expected_map[field]\n",
    "            question = question_map[field]\n",
