    "def aggregate_judge_ratings(\n",
    "    generated: pd.DataFrame,\n",
    "    path: Path,\n",
    ") -> pd.DataFrame:\n",
    "    raw = pd.DataFrame(read_jsonl(path))\n",
    "    if raw.empty:\n",
    "        raise RuntimeError(\"No GPT-5.6 Luna ratings were found\")\n",
    "\n",
    "    raw = raw[raw.get(\"rating_error\", pd.Series(index=raw.index)).isna()].copy()\n",
    "    required = {\n",
    "        \"sample_id\", \"score\", \"confidence\", \"valid_for_vector\",\n",
    "        \"reason\", \"evidence\", \"pass_index\",\n",
    "    }\n",
    "    missing = required - set(raw.columns)\n",
    "    if missing:\n",
    "        raise ValueError(f\"Judge output is missing columns: {missing}\")\n",
    "\n",
    "    rows = []\n",
    "    for sample_id, group in raw.groupby(\"sample_id\", sort=False):\n",
    "        scores = pd.to_numeric(group[\"score\"], errors=\"coerce\").dropna().to_numpy(float)\n",
    "        confidence = pd.to_numeric(\n",
