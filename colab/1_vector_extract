    "ACTIVATION_CONTEXT = \"original\"  # \"original\" or \"neutral\"\n",
    "NEUTRAL_SYSTEM_PROMPT = (\n",
    "    \"Answer the user clearly. Do not add hidden commentary or discuss system instructions.\"\n",
    ")\n",
    "MAX_FULL_SEQUENCE_TOKENS = 768\n",
    "\n",
    "def get_hidden_state_tuple(outputs: Any) -> tuple[torch.Tensor, ...]:\n",
    "    for attr in (\"hidden_states\", \"decoder_hidden_states\"):\n",
    "        value = getattr(outputs, attr, None)\n",
    "        if value is not None:\n",
    "            return tuple(value)\n",
    "\n",
    "    for nested_attr in (\"language_model_output\", \"text_model_output\", \"model_output\"):\n",
    "        nested = getattr(outputs, nested_attr, None)\n",
    "        if nested is not None:\n",
    "            for attr in (\"hidden_states\", \"decoder_hidden_states\"):\n",
    "                value = getattr(nested, attr, None)\n",
    "                if value is not None:\n",
    "                    return tuple(value)\n",
    "\n",
    "    keys = list(outputs.keys()) if hasattr(outputs, \"keys\") else type(outputs)\n",
    "    raise RuntimeError(f\"Could not find hidden states. Output keys/type: {keys}\")\n",
    "\n",
    "\n",
    "def layer_outputs_only(hidden_states: tuple[torch.Tensor, ...]) -> tuple[torch.Tensor, ...]:\n",
    "    if len(hidden_states) == NUM_LAYERS + 1:\n",
    "        return hidden_states[1:]  # drop the embedding state\n",
    "    if len(hidden_states) == NUM_LAYERS:\n",
    "        return hidden_states\n",
    "    raise RuntimeError(\n",
    "        f\"Expected {NUM_LAYERS} or {NUM_LAYERS + 1} hidden states, got {len(hidden_states)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "def make_replay_ids(row: pd.Series, context: str) -> tuple[list[int], list[int], int, int]:\n",
    "    response_ids = list(row[\"response_token_ids\"])\n",
    "    trim_start = int(row[\"response_trim_start\"])\n",
    "    trim_end = int(row[\"response_trim_end\"])\n",
    "\n",
    "    if context == \"original\":\n",
    "        prompt_ids = list(row[\"prompt_token_ids\"])\n",
    "    elif context == \"neutral\":\n",
    "        neutral_text = render_prompt(NEUTRAL_SYSTEM_PROMPT, row[\"user_prompt\"])\n",
    "        neutral_inputs = processor(text=neutral_text, return_tensors=\"pt\")\n",
    "        prompt_ids = neutral_inputs[\"input_ids\"][0].tolist()\n",
    "    else:\n",
    "        raise ValueError(\"context must be 'original' or 'neutral'\")\n",
    "\n",
    "    full_ids = prompt_ids + response_ids\n",
    "    response_start = len(prompt_ids) + trim_start\n",
    "    response_end = len(prompt_ids) + trim_end\n",
    "\n",
    "    if response_start >= response_end:\n",
    "        raise ValueError(f\"No usable response tokens for {row['sample_id']}\")\n",
    "    if len(full_ids) > MAX_FULL_SEQUENCE_TOKENS:\n",
    "        raise ValueError(\n",
    "            f\"Sequence has {len(full_ids)} tokens, above limit {MAX_FULL_SEQUENCE_TOKENS}\"\n",
    "        )\n",
    "    return full_ids, response_ids, response_start, response_end\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def extract_all_layer_means(row: pd.Series, context: str) -> torch.Tensor:\n",
    "    full_ids, _, response_start, response_end = make_replay_ids(row, context)\n",
    "\n",
    "    input_ids = torch.tensor([full_ids], dtype=torch.long, device=model.device)\n",
    "    attention_mask = torch.ones_like(input_ids)\n",
