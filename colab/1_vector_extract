    "def bootstrap_group_auc(\n",
    "    scores: np.ndarray,\n",
    "    labels: np.ndarray,\n",
    "    groups: np.ndarray,\n",
    "    n_boot: int = 1000,\n",
    "    seed: int = SEED,\n",
    ") -> tuple[float, float]:\n",
    "    rng = np.random.default_rng(seed)\n",
    "    unique_groups = np.unique(groups)\n",
    "    values = []\n",
    "\n",
    "    group_to_indices = {\n",
    "        g: np.where(groups == g)[0]\n",
    "        for g in unique_groups\n",
    "    }\n",
    "\n",
    "    for _ in range(n_boot):\n",
    "        sampled_groups = rng.choice(unique_groups, size=len(unique_groups), replace=True)\n",
    "        idx = np.concatenate([group_to_indices[g] for g in sampled_groups])\n",
    "        y = labels[idx]\n",
    "        if len(np.unique(y)) < 2:\n",
    "            continue\n",
    "        values.append(roc_auc_score(y, scores[idx]))\n",
    "\n",
    "    if not values:\n",
    "        return (np.nan, np.nan)\n",
    "    return tuple(np.quantile(values, [0.025, 0.975]))\n",
    "\n",
    "\n",
    "def fit_and_evaluate_trait(\n",
    "    trait: str,\n",
    "    data: dict,\n",
    "    layer: int,\n",
    "    package_name: str,\n",
    ") -> dict:\n",
    "    acts = data[\"acts\"]\n",
    "    meta = data[\"meta\"]\n",
    "    train_idx = data[\"train_idx\"]\n",
    "    test_idx = data[\"test_idx\"]\n",
    "\n",
    "    y = meta[\"binary_label\"].astype(int).to_numpy()\n",
    "    continuous = pd.to_numeric(meta[\"judge_score\"], errors=\"coerce\").to_numpy()\n",
    "    groups = meta[\"situation_id\"].to_numpy()\n",
    "\n",
    "    X_train = acts[train_idx, layer, :]\n",
    "    X_test = acts[test_idx, layer, :]\n",
    "    y_train = y[train_idx]\n",
    "    y_test = y[test_idx]\n",
    "\n",
    "    raw_vector = X_train[torch.tensor(y_train == 1)].mean(dim=0) - \\\n",
    "                 X_train[torch.tensor(y_train == 0)].mean(dim=0)\n",
    "    unit_vector = raw_vector / raw_vector.norm()\n",
    "\n",
    "    train_scores = (X_train @ unit_vector).numpy()\n",
    "    test_scores = (X_test @ unit_vector).numpy()\n",
    "\n",
    "    pos_mean = float(train_scores[y_train == 1].mean())\n",
    "    neg_mean = float(train_scores[y_train == 0].mean())\n",
    "    threshold = (pos_mean + neg_mean) / 2.0\n",
    "    pooled_scale = float(train_scores.std(ddof=1))\n",
    "    if pooled_scale <= 1e-8:\n",
    "        pooled_scale = 1.0\n",
    "\n",
    "    predictions = (test_scores >= threshold).astype(int)\n",
    "    auc = roc_auc_score(y_test, test_scores)\n",
    "    bal_acc = balanced_accuracy_score(y_test, predictions)\n",
    "    acc = accuracy_score(y_test, predictions)\n",
    "    rho = spearmanr(continuous[test_idx], test_scores, nan_policy=\"omit\").statistic\n",
    "\n",
    "    calibrator = LogisticRegression(random_state=SEED)\n",
    "    calibrator.fit(train_scores.reshape(-1, 1), y_train)\n",
    "    probabilities = calibrator.predict_proba(test_scores.reshape(-1, 1))[:, 1]\n",
    "\n",
    "    ci_low, ci_high = bootstrap_group_auc(\n",
    "        test_scores,\n",
    "        y_test,\n",
    "        groups[test_idx],\n",
    "    )\n",
    "\n",
    "    cfg = TRAIT_CONFIGS[trait]\n",
    "    metrics = {\n",
    "        \"trait\": trait,\n",
    "        \"positive_label\": cfg[\"positive\"],\n",
    "        \"negative_label\": cfg[\"negative\"],\n",
    "        \"layer\": layer,\n",
    "        \"test_auc\": float(auc),\n",
    "        \"test_auc_ci95\": [float(ci_low), float(ci_high)],\n",
    "        \"test_accuracy\": float(acc),\n",
    "        \"test_balanced_accuracy\": float(bal_acc),\n",
    "        \"test_spearman\": float(rho) if np.isfinite(rho) else None,\n",
    "        \"confusion_matrix\": confusion_matrix(y_test, predictions).tolist(),\n",
    "        \"n_train\": int(len(train_idx)),\n",
    "        \"n_test\": int(len(test_idx)),\n",
    "        \"n_train_positive\": int(y_train.sum()),\n",
    "        \"n_train_negative\": int((1 - y_train).sum()),\n",
    "        \"n_test_positive\": int(y_test.sum()),\n",
    "        \"n_test_negative\": int((1 - y_test).sum()),\n",
    "    }\n",
    "\n",
    "    package = {\n",
    "        \"model_id\": MODEL_ID,\n",
    "        \"model_revision\": MODEL_REVISION,\n",
    "        \"run_mode\": RUN_MODE,\n",
    "        \"activation_context\": ACTIVATION_CONTEXT,\n",
    "        \"judge_model\": JUDGE_MODEL_ID,\n",
    "        \"judge_prompt_version\": JUDGE_PROMPT_VERSION,\n",
    "        \"judge_passes\": JUDGE_PASSES,\n",
    "        \"judge_reasoning_effort\": JUDGE_REASONING_EFFORT,\n",
    "        \"trait\": trait,\n",
    "        \"positive_label\": cfg[\"positive\"],\n",
    "        \"negative_label\": cfg[\"negative\"],\n",
    "        \"layer\": layer,\n",
    "        \"raw_vector\": raw_vector.to(torch.float16),\n",
    "        \"unit_vector\": unit_vector.to(torch.float16),\n",
    "        \"train_positive_score_mean\": pos_mean,\n",
    "        \"train_negative_score_mean\": neg_mean,\n",
    "        \"decision_threshold\": threshold,\n",
    "        \"score_scale\": pooled_scale,\n",
    "        \"calibrator_coef\": float(calibrator.coef_[0, 0]),\n",
    "        \"calibrator_intercept\": float(calibrator.intercept_[0]),\n",
    "        \"metrics\": metrics,\n",
    "        \"generation_config\": GENERATION,\n",
    "        \"created_at_utc\": datetime.now(timezone.utc).isoformat(),\n",
    "    }\n",
    "\n",
    "    path = DIRS[\"vectors\"] / f\"{package_name}__{trait}.pt\"\n",
    "    torch.save(package, path)\n",
    "\n",
    "    test_table = meta.iloc[test_idx][\n",
    "        [\"sample_id\", \"situation_id\", \"judge_score\", \"judge_confidence\", \"judge_reason\", \"binary_label\", \"response_text\"]\n",
    "    ].copy()\n",
    "    test_table[\"raw_score\"] = test_scores\n",
    "    test_table[\"z_score\"] = (test_scores - threshold) / pooled_scale\n",
    "    test_table[\"positive_probability\"] = probabilities\n",
    "    test_table.to_csv(\n",
    "        DIRS[\"metrics\"] / f\"{package_name}__{trait}__test_predictions.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    return {\"package\": package, \"path\": path, \"metrics\": metrics}\n",
    "\n",
    "\n",
    "results_per_trait_layer = {}\n",
